# carbonTraceAI environment

# Data paths
CARBONTRACE_DATA_DIR=./data
CARBONTRACE_DB_URL=sqlite:///./data/carbontrace.db

# Logging
CARBONTRACE_LOG_LEVEL=INFO

# OCR
TESSERACT_CMD=/opt/homebrew/bin/tesseract

# Airbyte (optional — only if hitting a live Airbyte deployment)
AIRBYTE_API_URL=http://localhost:8000/api/v1
AIRBYTE_USERNAME=airbyte
AIRBYTE_PASSWORD=password